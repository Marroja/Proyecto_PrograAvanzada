@startuml
title Flujo principal en modo multihilo (CLI)

actor Usuario

participant "Main" as Main
participant "InterfazTerminal" as UI
participant "GestorEstaciones" as GE
participant "Maestro" as M
participant "Trabajador" as T
participant "AnalizadorEstacion" as AE
participant "Estacion" as E
participant "Bitacora" as B

Usuario -> Main : ejecuta programa\n(java Main)
Main -> UI : new InterfazTerminal()

Usuario -> UI : ingresa filtros de estación y datos
UI -> GE : new GestorEstaciones()
UI -> GE : cargarDesdeXML()
GE -> B : movimiento("Cargando estaciones")
GE --> UI : Estacion[]

UI -> GE : filtrar(FiltroEstacion)
GE --> UI : Estacion[] filtradas

UI -> M : new Maestro(estacionesFiltradas, filtroDatos)
UI -> M : start()

par Para cada Trabajador
  M -> T : crear Trabajador(subconjuntoEstaciones, filtroDatos)
  M -> T : start()
end

loop Por cada estación en el Trabajador
  T -> AE : new AnalizadorEstacion(Estacion, FiltroDatos)
  AE -> E : obtener URL / metadatos
  AE -> AE : descargarDatos()
  AE -> AE : parsearCSV()
  AE -> AE : filtrarDatos()
  AE --> T : RenglonDatos[]
end

T -> B : movimiento("Trabajador termina\nsu bloque")
T --> M : RenglonDatos[] (limpios)

M -> B : movimiento("Maestro recolecta resultados")
M --> UI : RenglonDatos[] (finales)

UI -> Usuario : muestra resultados\n(tiempo, nº de renglones, etc.)

@enduml
