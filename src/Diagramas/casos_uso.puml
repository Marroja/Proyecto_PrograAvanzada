@startuml
title Casos de uso del sistema

actor "Usuario" as U

rectangle "Sistema de análisis de estaciones" {
  usecase "Configurar filtros\nde estación" as UC1
  usecase "Configurar filtros\nde datos" as UC2
  usecase "Ejecutar análisis\nmonohilo" as UC3
  usecase "Ejecutar análisis\nmultihilo" as UC4
  usecase "Ver resultados\ny resumen" as UC5
  usecase "Exportar resultados\na archivo" as UC6
  usecase "Consultar bitácora\nde errores" as UC7
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7

UC3 ..> UC2 : <<incluye>>
UC4 ..> UC2 : <<incluye>>
UC5 ..> UC3 : <<extiende>>
UC5 ..> UC4 : <<extiende>>
UC6 ..> UC5 : <<extiende>>
UC7 ..> UC3 : <<extiende>>
UC7 ..> UC4 : <<extiende>>

@enduml
