@startuml
title Despliegue del sistema

node "PC del usuario\n(macOS/Windows/Linux)" as PC {
  node "JVM" as JVM {
    artifact "Aplicacion.jar" as APP
  }

  artifact "bitacora.txt" as LOG_A
  artifact "bitacoraErrores.txt" as LOG_E
  artifact "estaciones.xml" as XML
  artifact "resultados.csv" as RES
}

node "Servidor CONAGUA" as SERV {
  artifact "Base de datos\nCSV remotos" as CSV_REMOTE
}

PC --> SERV : HTTPS (AnalizadorEstacion\nusa URL/HttpsURLConnection)
APP --> XML : lee configuración\nde estaciones (LectorXML)
APP --> LOG_A : escribe movimientos\n(Bitacora)
APP --> LOG_E : escribe errores\n(Bitacora)
APP --> RES : escribe resultados\n(EscritorDatos)

@enduml
