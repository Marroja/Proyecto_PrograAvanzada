@startuml
title Componentes del proyecto de estaciones CONAGUA

'-------------------------
' Estilo general
'-------------------------
skinparam backgroundColor #FFFFFF
skinparam shadowing true

skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultTextAlignment center

skinparam titleFontSize 20
skinparam titleFontStyle bold

'-------------------------
' Estilo de componentes
'-------------------------
skinparam componentStyle uml2

skinparam component {
    FontStyle       bold
    FontSize        16
    BorderColor     #2C3E50
    BackgroundColor #ECF0F1
    ArrowColor      #34495E
    StereotypeFontColor #2C3E50
}

skinparam file {
    BackgroundColor #FFFFFF
    BorderColor     #7F8C8D
    FontSize        12
}

'-------------------------
' COMPONENTES CON SUS CLASES INTERNAS
'-------------------------

component "Aplicación\n(Main)" as C_Main {
    file "Main" as MainFile
}

component "Interfaz de Usuario" as C_UI {
    file "InterfazTerminal" as InterfazTerminalFile
    file "Ventana" as VentanaFile
}

component "Gestión de Estaciones\ny Datos" as C_Est {
    file "Estacion"            as EstacionFile
    file "GestorEstaciones"    as GestorEstacionesFile
    file "AnalizadorEstacion"  as AnalizadorEstacionFile
    file "RenglonDatos"        as RenglonDatosFile
    file "FiltroEstacion"      as FiltroEstacionFile
    file "FiltroDatos"         as FiltroDatosFile
}

component "Motor Concurrente" as C_Conc {
    file "MonoHilo"   as MonoHiloFile
    file "Maestro"    as MaestroFile
    file "Trabajador" as TrabajadorFile
}

component "Utilidades" as C_Utils {
    file "Matematicas"   as MatematicasFile
    file "LectorXML"     as LectorXMLFile
    file "EscritorDatos" as EscritorDatosFile
}

component "Bitácora / Log" as C_Log {
    file "Bitacora" as BitacoraFile
}

'-------------------------
' DEPENDENCIAS ENTRE COMPONENTES
'-------------------------

C_Main --> C_UI : crea InterfazTerminal\n(opcional: Ventana)

C_UI --> C_Est   : pide estaciones filtradas\ncrea Filtros
C_UI --> C_Conc  : lanza Maestro/MonoHilo
C_UI --> C_Utils : usa Matematicas

C_Est --> C_Utils : usa LectorXML,\nMatematicas
C_Est --> C_Log   : registra eventos

C_Conc --> C_Est : procesa Estacion y\nRenglonDatos
C_Conc --> C_Log : tiempos,\nerrores de hilos

C_Utils --> C_Log : errores de IO/parsing

@enduml
